PORT=8000
RAG_URL=http://localhost:8001
MCP_URL=http://localhost:8002/mcp
DATABASE_URL=postgresql://support:support@localhost:5432/support_desk

# OpenRouter — one key, any model id per agent (https://openrouter.ai/models)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
CHEAP_MODEL=openai/gpt-4o-mini
MAIN_MODEL=anthropic/claude-haiku-4.5

# Context summarization
CONTEXT_TOKEN_BUDGET=128000
SUMMARIZE_THRESHOLD_RATIO=0.7
KEEP_RECENT_MESSAGES=8

# Email (stub only in v1)
EMAIL_PROVIDER=stub

# Shared with mcp-server. Signs refund approvals. Change both before exposing MCP.
# APPROVAL_SECRET=dev-approval-secret

# LangSmith. Chat runs are sent to LANGSMITH_PROJECT. Set tracing to false to stop.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=support-agent

# Optional USD per 1M tokens for agent eval cost
# CHAT_INPUT_USD_PER_MILLION=
# CHAT_OUTPUT_USD_PER_MILLION=
