PORT=8001
DATABASE_URL=postgresql://support:support@localhost:5432/support_desk
REDIS_URL=redis://localhost:6379

# OpenRouter — chat answers and embeddings (https://openrouter.ai/models)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MAIN_MODEL=anthropic/claude-haiku-4.5
JUDGE_MODEL=openai/gpt-4.1
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIM=1536

# Chunking
CHUNK_TOKENS=800
CHUNK_OVERLAP=100

# Optional USD per 1M tokens, used when the provider does not return a cost
# CHAT_INPUT_USD_PER_MILLION=
# CHAT_OUTPUT_USD_PER_MILLION=
# EMBEDDING_USD_PER_MILLION=

# LangSmith eval upload
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=support-desk-rag

# Set to false to run the API without the ingest worker
WORKER_ENABLED=true
